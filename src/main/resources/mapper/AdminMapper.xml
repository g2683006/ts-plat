<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="AS.Demo.dao.AdminMapper">
    <insert id="AddAdmin" parameterType="AS.Demo.po.Admin">
        INSERT INTO admin VALUES(#{admin_id},#{admin_password},#{admin_name})
    </insert>
    <select id="SelectAdmin" parameterType="AS.Demo.po.Admin" resultType="AS.Demo.po.Admin">
        SELECT * FROM admin WHERE admin_id=#{admin_id} AND admin_password=#{admin_password}
    </select>

    <select id="SelectByAdminId" resultType="AS.Demo.po.Admin">
        SELECT * FROM admin WHERE admin_id=#{admin_id}
    </select>
</mapper>